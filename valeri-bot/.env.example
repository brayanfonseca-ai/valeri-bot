# Puerto HTTP del bot (webhook de Meta + /health). Verificar que esté libre en el servidor.
PORT=3010

# Meta WhatsApp Cloud API
META_JWT_TOKEN=<token de acceso de Meta>
META_NUMBER_ID=<phone number id>
META_WABA_ID=<whatsapp business account id>
META_VERIFY_TOKEN=<texto aleatorio que también se pone en el panel de Meta al configurar el webhook>
META_VERSION=v26.0
# Opcional pero recomendado: App Secret de la app de Meta para validar X-Hub-Signature-256
META_APP_SECRET=

# Formulario de registro (WhatsApp Flow). Definición en meta/registro.flow.json
# Versión vigente: valeri_registro_v3 (cédula 5-15 dígitos).
META_FLOW_ID=<id del flow creado en la cuenta de Valeri>
# true mientras el flow esté en borrador; false cuando se publique
META_FLOW_DRAFT=false

# Base de datos de Valeri (PostgreSQL local, base valeri_bot). Ver prisma/schema.prisma
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/valeri_bot?schema=public"
# Minutos sin actividad para cerrar una sesión y avisar al empleado (tabla sessions)
VALERI_SESION_TIMEOUT_MIN=10

# Validación de empleados
#   bd      -> (por defecto) tabla users de valeri_bot: cédula Y celular deben coincidir
#              (se carga con: npm run db:importar-usuarios)
#   abierta -> PRUEBAS: todo el que confirma sus datos queda autorizado
#   etl     -> consulta ETL_VALIDACION_URL (contrato en src/validacion.ts)
VALERI_VALIDACION=bd
ETL_VALIDACION_URL=<url completa del endpoint de validación de ETL (aún no existe)>

# API de ETL (services_buk TV). Swagger:
# http://etl-integracion.s3-website.us-east-2.amazonaws.com/swagger/tv-prd-services-buk/
ETL_BASE_URL=https://ibs9x7piq3.execute-api.us-east-2.amazonaws.com/Prod
# API Key del API Gateway de ETL (cabecera x-api-key)
ETL_TOKEN=<api key de ETL>

# Calendario para elegir la fecha de inicio de vacaciones (WhatsApp Flow). Definición en meta/calendario.flow.json
# Vacío = se usan las listas año -> mes -> día.
META_FLOW_CALENDARIO_ID=<id del flow del calendario>

# Solicitud de vacaciones (POST a ETL). Ruta relativa a ETL_BASE_URL, ej. /vacaciones
# VACÍA mientras ETL no la publique: el bot arma la solicitud pero no la envía.
ETL_SOLICITUD_VACACIONES_RUTA=
# Valores fijos del cuerpo (modelo Buk POST /vacations). Opcionales; estos son los valores por defecto.
# VACACIONES_TIPO=legales
# VACACIONES_PERCENT_DAY=100            (porcentaje de la jornada, NO cantidad de días)
# VACACIONES_WORKDAY_STAGE=full_working_day

# TLS saliente detrás del proxy corporativo (Acronis). OBLIGATORIO en el servidor:
# sin esto Node falla con "fetch failed" hacia Meta y ETL. La CA se exporta del almacén
# raíz de Windows a certs/acronis-ca.pem (fuera de git). Nunca se desactiva la verificación TLS.
TLS_EXTRA_CA=./certs/acronis-ca.pem
NODE_EXTRA_CA_CERTS=./certs/acronis-ca.pem

# ============================================================================
# Agente de IA de AWS (opción "Hablar con agente"). Ver docs/guia-integracion-app.md
# ============================================================================
# Harness de Bedrock AgentCore. VACÍO = la opción sigue "en construcción".
AGENTE_ARN=<arn del harness>
AGENTE_REGION=us-east-2
# Tabla DynamoDB del control de identidad (cédula de cada conversación). VACÍA = sin control:
# la opción queda CERRADA para los colaboradores (solo AGENTE_NUMEROS_PRUEBA), salvo
# AGENTE_PERMITIR_SIN_CONTROL=true (no recomendado: permitiría suplantación).
AGENTE_TABLA_SESIONES=
AGENTE_PERMITIR_SIN_CONTROL=false
# wa_id separados por coma que pueden usar el agente aunque esté cerrado (pruebas)
AGENTE_NUMEROS_PRUEBA=
# Tiempo máximo por invocación (ms)
AGENTE_TIMEOUT_MS=90000
# Credencial de AWS (el SDK la lee sola). NUNCA en git: el repositorio es público.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
