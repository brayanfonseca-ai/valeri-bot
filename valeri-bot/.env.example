# Puerto HTTP del bot (webhook de Meta + /health). Verificar que esté libre en el servidor.
PORT=3010

# Meta WhatsApp Cloud API
META_JWT_TOKEN=<token de acceso de Meta>
META_NUMBER_ID=<phone number id>
META_WABA_ID=<whatsapp business account id>
META_VERIFY_TOKEN=<texto aleatorio que también se pone en el panel de Meta al configurar el webhook>
META_VERSION=v26.0
# Opcional pero recomendado: App Secret de la app de Meta para validar X-Hub-Signature-256
META_APP_SECRET=

# Formulario de registro (WhatsApp Flow). Definición en meta/registro.flow.json
META_FLOW_ID=<id del flow creado en la cuenta de Valeri>
# true mientras el flow esté en borrador; false cuando se publique
META_FLOW_DRAFT=false

# Validación de empleados contra Buk
#   abierta -> PRUEBAS: todo el que confirma sus datos queda autorizado
#   etl     -> PRODUCCIÓN: consulta ETL_VALIDACION_URL (contrato en src/validacion.ts)
VALERI_VALIDACION=etl
ETL_VALIDACION_URL=<url del endpoint de validación de ETL>
ETL_TOKEN=<token del endpoint de ETL, si lo exige>

# TLS saliente detrás del proxy corporativo (opcional, ver guía 00 §6)
# TLS_EXTRA_CA=./certs/acronis-ca.pem
# NODE_EXTRA_CA_CERTS=./certs/acronis-ca.pem
