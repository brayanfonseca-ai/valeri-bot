    "@builderbot/provider-meta": "1.4.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "rollup": "4.68.2",
    "rollup-plugin-typescript2": "0.37.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
